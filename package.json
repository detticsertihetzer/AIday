{
  "name": "catalyst",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "24.15.0",
    "bun": "1.3.13"
  },
  "packageManager": "bun@1.3.13",
  "scripts": {
    "dev": "next dev",
    "scan": "REACT_SCAN=true next dev",
    "analyze": "ANALYZE=true next build --webpack",
    "build": "next build",
    "build:standalone": "EXPORT_MODE=standalone next build",
    "start": "next start",
    "type-check": "tsc --noEmit",
    "db:push": "prisma db push",
    "db:seed": "bun prisma/seed.ts",
    "db:setup": "prisma db push && bun prisma/seed.ts",
    "postinstall": "prisma generate",
    "test": "bun test",
    "lint-staged": "lint-staged",
    "format": "biome format",
    "format-write": "biome format --write",
    "lint": "biome lint",
    "lint-write": "biome lint --write",
    "check": "biome check",
    "check-write": "biome check --write",
    "knip": "knip",
    "jscpd": "jscpd --noTips",
    "klint": "klint",
    "update:patch": "ncu -u --target patch -p bun && bun i",
    "update:minor": "ncu -u --target minor -p bun && bun i",
    "configure": "bun scripts/configure.ts",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "bun run check"
    ]
  },
  "dependencies": {
    "@libsql/client": "0.17.3",
    "@microsoft/clarity": "1.0.2",
    "@prisma/adapter-libsql": "7.8.0",
    "@prisma/client": "7.8.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "lucide-react": "1.12.0",
    "next": "16.2.4",
    "next-themes": "0.4.6",
    "prisma": "7.8.0",
    "radix-ui": "^1.4.3",
    "react": "19.2.5",
    "react-dom": "19.2.5",
    "server-only": "0.0.1",
    "sonner": "2.0.7",
    "tailwind-merge": "3.5.0",
    "tw-animate-css": "1.4.0",
    "winston": "3.19.0",
    "winston-transport": "4.9.0",
    "zod": "4.3.6"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.13",
    "@konvert7/klint": "0.8.0",
    "@next/bundle-analyzer": "16.2.4",
    "@opencode-ai/plugin": "1.14.28",
    "@tailwindcss/postcss": "4.2.4",
    "@types/bun": "1.3.13",
    "@types/node": "24.12.2",
    "@types/prompts": "2.4.9",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "babel-plugin-react-compiler": "1.0.0",
    "commander": "14.0.3",
    "husky": "9.1.7",
    "jscpd": "4.2.3",
    "knip": "6.7.0",
    "lint-staged": "16.4.0",
    "npm-check-updates": "22.0.1",
    "postcss": "8.5.12",
    "postcss-load-config": "6.0.1",
    "prompts": "2.4.2",
    "shadcn": "4.6.0",
    "tailwindcss": "4.2.4",
    "typescript": "6.0.3"
  },
  "overrides": {
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3"
  }
}
